# Cấu hình môi trường cho Trợ lý Văn phòng AI
ENVIRONMENT=development
DATABASE_PATH=app.db

# Cấu hình LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình Email Provider (mock hoặc google, mặc định: mock)
EMAIL_PROVIDER=mock

# ================================================================
# Cấu hình Xác thực Google OAuth 2.0 (Danh tính người dùng)
# ================================================================
# Đường dẫn file client_secret cho Web App (OAuth 2.0 Web Application)
# Tải từ Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Loại: Web Application (không phải Desktop App)
GOOGLE_WEB_CLIENT_FILE=backend/secrets/web_client_secret.json

# URL gốc của ứng dụng (không có dấu / cuối)
APP_BASE_URL=http://localhost:5173

# Thời hạn phiên đăng nhập (ngày)
SESSION_DAYS=30

# Danh sách email được phép đăng nhập (cách nhau bằng dấu phẩy)
# Để trống = cho phép mọi tài khoản Google
# ALLOWED_EMAILS=user1@gmail.com,user2@company.com

# ================================================================
# Redirect URI cần khai báo trên Google Cloud Console:
#   http://localhost:5173/auth/google/callback    (phát triển)
#   https://yourdomain.com/auth/google/callback   (production)
# ================================================================
