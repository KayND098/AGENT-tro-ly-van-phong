# ================================================================
# Cấu hình Môi trường Trợ lý Văn phòng AI (Bản v1)
# ================================================================

# 1. Chế độ xác thực (AUTH_MODE): "demo" hoặc "google" (Mặc định mã nguồn: google)
# - "demo": Chạy thử nhanh với người dùng mẫu "Demo", không cần Google OAuth,
#           ép EMAIL_PROVIDER=mock, chỉ dùng trên localhost.
# - "google": Xác thực tài khoản Google OAuth 2.0 Web Client của chính bạn.
AUTH_MODE=demo

# 2. Đường dẫn dữ liệu (SQLite & Tài liệu RAG)
# Trong Docker Compose, dữ liệu lưu vào volume /data; không ghi vào mã nguồn.
# Khi chạy python cục bộ, có thể dùng: app.db và backend/data/docs
DATABASE_PATH=/data/app.db
DOCS_DIR=/app/data/docs

# 3. URL gốc của ứng dụng (không có dấu / ở cuối)
# Demo chỉ cho phép localhost/127.0.0.1 và giao thức http://
APP_BASE_URL=http://localhost:5173

# 4. Thời hạn phiên đăng nhập (ngày)
SESSION_DAYS=30

# 5. Cấu hình Email Provider: "mock" (mặc định) hoặc "google"
# Lưu ý: Khi AUTH_MODE=demo, hệ thống luôn ép EMAIL_PROVIDER=mock để đảm bảo an toàn.
EMAIL_PROVIDER=mock

# 6. Cấu hình LLM: "fake" (mặc định, không cần key) hoặc "gemini"
LLM_PROVIDER=fake

# Khóa API Gemini (chỉ cần khi LLM_PROVIDER=gemini)
# Lưu ý: Tài khoản miễn phí của Google có thể dùng dữ liệu prompt để cải thiện sản phẩm,
# chỉ nên nhập dữ liệu giả lập/thử nghiệm khi dùng key cá nhân.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ================================================================
# Cấu hình Dành riêng cho AUTH_MODE=google (Tùy chọn)
# ================================================================
# File OAuth 2.0 Client Secret (loại Web Application) tải từ Google Cloud Console
GOOGLE_WEB_CLIENT_FILE=backend/secrets/web_client_secret.json

# Khóa mã hóa token Google bằng Fernet (AES-128-CBC + HMAC-SHA256)
# Sinh khóa mới bằng lệnh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_key_here

# Danh sách email được phép đăng nhập (cách nhau bởi dấu phẩy). Để trống = cho phép mọi tài khoản.
# ALLOWED_EMAILS=user1@gmail.com,user2@company.com

# Redirect URI cần khai báo trên Google Cloud Console:
# http://localhost:5173/auth/google/callback
